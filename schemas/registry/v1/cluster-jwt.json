{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teremoqwow.dev/schemas/registry/v1/cluster-jwt.json",
  "title": "ClusterJwtClaims",
  "description": "Claims del JWT emitido por KrakenD /registry/join a nodos federados. Autoriza únicamente el namespace contrib/{node_id}/.",
  "type": "object",
  "additionalProperties": true,
  "required": ["sub", "node_id", "region", "namespace_pattern", "exp", "iat"],
  "properties": {
    "sub": { "type": "string", "description": "node_id del relay solicitante." },
    "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "region": { "type": "string" },
    "namespace_pattern": {
      "type": "string",
      "description": "Glob que este nodo puede publicar. Siempre 'contrib/{node_id}/**'.",
      "pattern": "^contrib/[a-z0-9][a-z0-9-]*/\\*\\*$"
    },
    "exp": { "type": "integer", "description": "Unix timestamp. Caducidad máxima 24h." },
    "iat": { "type": "integer" }
  }
}
