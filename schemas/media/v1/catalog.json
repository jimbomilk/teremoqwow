{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teremoqwow.dev/schemas/media/v1/catalog.json",
  "title": "MoQCatalog",
  "description": "MoQ Catalog v1 publicado por moq-mux para describir los tracks de un broadcast.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "namespace", "tracks"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "namespace": {
      "type": "string",
      "description": "Namespace MoQ del broadcast (segmentos separados por '/').",
      "pattern": "^[a-z0-9][a-z0-9/-]*$"
    },
    "created_at": {
      "$ref": "https://teremoqwow.dev/schemas/common/v1/timestamp.json"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "codec", "init_track"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Nombre único del track dentro del namespace.",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "type": "string",
          "enum": ["video", "audio", "data", "sync"]
        },
        "codec": {
          "type": "string",
          "description": "MIME con parámetros RFC 6381 para media; identificador libre para 'data'/'sync'."
        },
        "init_track": {
          "type": "string",
          "description": "Nombre del track que transporta init segment / config."
        },
        "bitrate_kbps": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "framerate": { "type": "number", "exclusiveMinimum": 0 },
        "channels": { "type": "integer", "minimum": 1 },
        "sample_rate_hz": { "type": "integer", "minimum": 1 },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "role": {
          "type": "string",
          "enum": ["main", "alternate", "commentary", "description", "captions", "subtitles"]
        },
        "selection_group": {
          "type": "string",
          "description": "Los tracks con el mismo selection_group son alternativas mutuamente excluyentes (ABR)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "video" } }, "required": ["kind"] },
          "then": { "required": ["width", "height", "framerate", "bitrate_kbps"] }
        },
        {
          "if": { "properties": { "kind": { "const": "audio" } }, "required": ["kind"] },
          "then": { "required": ["channels", "sample_rate_hz", "bitrate_kbps"] }
        }
      ]
    }
  }
}
