# =====================================================================
# teremoqwow · plantilla de variables de entorno
# Copia a `.env` (ignorado por git) y rellena con valores reales.
# NUNCA commitees este archivo con secretos reales.
# =====================================================================

# ── MediaMTX (ingesta SRT) ───────────────────────────────────────────
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_API_PORT=9997
MEDIAMTX_LOG_LEVEL=info

# ── SRT bonding ──────────────────────────────────────────────────────
SRT_BONDING_ENABLED=false
SRT_BONDING_PATHS=

# ── moq-mux (transcodificación) ──────────────────────────────────────
MOQ_MUX_INPUT_URL=srt://127.0.0.1:8890
MOQ_MUX_OUTPUT_RELAY=https://relay.local:4443
MOQ_MUX_RENDITIONS=1080p60,720p60,480p30

# ── moq-relay-ietf ───────────────────────────────────────────────────
RELAY_LISTEN=0.0.0.0:4443
RELAY_TLS_CERT=/etc/teremoqwow/relay.pem
RELAY_TLS_KEY=/etc/teremoqwow/relay.key
RELAY_ANNOUNCE_NAMESPACE=teremoqwow

# ── KrakenD API Gateway ──────────────────────────────────────────────
KRAKEND_PORT=8080
KRAKEND_CONFIG=/etc/krakend/krakend.json

# ── Stripe (test) ────────────────────────────────────────────────────
STRIPE_API_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_PORTAL_RETURN_URL=https://teremoqwow.dev/account

# ── EZDRM ────────────────────────────────────────────────────────────
EZDRM_USER=
EZDRM_PASSWORD=
EZDRM_WIDEVINE_URL=
EZDRM_PLAYREADY_URL=
EZDRM_FAIRPLAY_URL=

# ── GeoIP ────────────────────────────────────────────────────────────
GEOIP_DB_PATH=/var/lib/geoip/GeoLite2-Country.mmdb

# ── Observabilidad ───────────────────────────────────────────────────
QOS_METRICS_PORT=9464
LOG_FORMAT=json
