# teremoqwow — variables de entorno de desarrollo
# Uso: cp .env.example .env
# NUNCA committear .env con valores reales

# ── MoQ Relay ──────────────────────────────────────────────────────────────
# El player se conecta al relay via WebSocket/QUIC
VITE_MOQ_RELAY_URL=ws://localhost:4443/anon
VITE_RELAY_BROADCAST=anon/live1

# ── Billing / DRM ──────────────────────────────────────────────────────────
# Stripe webhook signing secret (stub para dev — usar sk_test_* real en producción)
WEBHOOK_SECRET=whsec_dev_secret_replace_in_prod
# Clave privada RSA para JWT RS256 — generada por scripts/renew-dev-certs.sh
JWT_RS256_PRIVATE_KEY_PATH=./config/relay/certs/private.pem

# ── Registry / Federación ─────────────────────────────────────────────────
REGISTRY_PRIVATE_KEY_PATH=./config/relay/certs/private.pem
REGISTRY_PORT=8081

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ClickHouse ───────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=teremoqwow
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Grafana ──────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=dev-grafana

# ── Stripe (stub — reemplazar con claves reales para pagos) ───────────────
STRIPE_SECRET_KEY=sk_test_replace_with_real_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_real_key

# ── Moesif (stub) ────────────────────────────────────────────────────────
MOESIF_APPLICATION_ID=replace_with_moesif_app_id
# ── LLM para generación de overlays ─────────────────────────────────────
# Proveedor: stub (sin API, default) | gemini | openai
LLM_PROVIDER=stub
# Gemini (recomendado)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
# OpenAI (alternativo)
OPENAI_API_KEY=
# ── Certificados TLS (generados por scripts/renew-dev-certs.sh) ───────────
# Los certs se montan desde config/relay/certs/ en los contenedores
